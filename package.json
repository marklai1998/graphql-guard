{
  "name": "graphql-guard",
  "description": "GraphQL Server permissions as another layer of abstraction!",
  "keywords": [
    "graphql",
    "graphql-shield",
    "graphql-middleware",
    "permissions",
    "authorization",
    "auth",
    "rules",
    "security",
    "middleware"
  ],
  "version": "0.0.0",
  "author": "Mark Lai <marklai1998@pm.me>",
  "license": "MIT",
  "homepage": "https://github.com/marklai1998/graphql-guard",
  "bugs": {
    "url": "https://github.com/marklai1998/graphql-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marklai1998/graphql-guard.git"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown --format esm --format cjs",
    "test": "vitest run --coverage",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/yup": "0.29.13",
    "object-hash": "^3.0.0",
    "yup": "^0.32.0"
  },
  "peerDependencies": {
    "graphql": "^0.11.0 || ^0.12.0 || ^0.13.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "graphql-middleware": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@graphql-tools/schema": "8.5.1",
    "@graphql-tools/utils": "8.9.0",
    "@marklai/shared-config-biome": "1.0.2",
    "@marklai/shared-config-commitlint": "1.1.3",
    "@types/node": "18.6.4",
    "@types/node-fetch": "^2.6.2",
    "@types/object-hash": "2.2.1",
    "@types/request-promise-native": "1.0.18",
    "@vitest/coverage-v8": "5.1.0",
    "apollo-server": "3.10.0",
    "graphql": "16.5.0",
    "graphql-middleware": "6.1.33",
    "graphql-shield-rules": "0.0.1",
    "lefthook": "2.2.2",
    "node-fetch": "^2.6.7",
    "tsdown": "0.23.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
