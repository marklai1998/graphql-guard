{
  "name": "graphql-guard",
  "description": "GraphQL Server permissions as another layer of abstraction!",
  "keywords": [
    "graphql",
    "graphql-shield",
    "permissions",
    "authorization",
    "auth",
    "rules",
    "security",
    "middleware"
  ],
  "version": "0.0.0",
  "author": "Mark Lai <marklai1998@pm.me>",
  "license": "MIT",
  "homepage": "https://github.com/marklai1998/graphql-guard",
  "bugs": {
    "url": "https://github.com/marklai1998/graphql-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marklai1998/graphql-guard.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run performance"
  },
  "dependencies": {
    "@graphql-tools/utils": "^12.1.0",
    "object-hash": "^3.0.0"
  },
  "peerDependencies": {
    "graphql": "^14.4.0 || ^15.0.0 || ^16.0.0 || ^17.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@apollo/server": "5.5.2",
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@graphql-tools/schema": "11.0.9",
    "@marklai/shared-config-biome": "1.0.2",
    "@marklai/shared-config-commitlint": "1.1.3",
    "@marklai/shared-config-typescript": "1.1.2",
    "@types/node": "22.20.5",
    "@types/object-hash": "3.0.6",
    "@vitest/coverage-v8": "5.1.0",
    "graphql": "16.15.0",
    "graphql-middleware": "6.1.35",
    "graphql-shield": "7.6.5",
    "graphql-yoga": "6.1.0",
    "lefthook": "2.2.2",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
