{
  "name": "graphql-guard",
  "description": "GraphQL Server permissions as another layer of abstraction!",
  "version": "0.0.0",
  "author": "Mark Lai <marklai1998@pm.me>",
  "license": "MIT",
  "homepage": "https://github.com/marklai1998/graphql-guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/marklai1998/graphql-guard.git"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "test": "vitest run --coverage",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@types/yup": "0.29.13",
    "object-hash": "^3.0.0",
    "tslib": "^2.4.0",
    "yup": "^0.32.0"
  },
  "peerDependencies": {
    "graphql": "^0.11.0 || ^0.12.0 || ^0.13.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "graphql-middleware": "^2.0.0 || ^3.0.0 || ^4.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@graphql-tools/schema": "8.5.1",
    "@graphql-tools/utils": "8.9.0",
    "@marklai/shared-config-biome": "1.0.2",
    "@marklai/shared-config-commitlint": "1.1.3",
    "@types/node": "18.6.4",
    "@types/node-fetch": "^2.6.2",
    "@types/object-hash": "2.2.1",
    "@types/request-promise-native": "1.0.18",
    "@vitest/coverage-v8": "5.1.0",
    "apollo-server": "3.10.0",
    "bob-the-bundler": "^4.0.0",
    "graphql": "16.5.0",
    "graphql-middleware": "6.1.33",
    "graphql-shield-rules": "0.0.1",
    "lefthook": "2.2.2",
    "node-fetch": "^2.6.7",
    "typescript": "4.7.4",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "packageManager": "pnpm@12.21.0"
}
